1:["$","main",null,{"id":"main","children":[["$","header",null,{"className":"service-directory-intro shell","children":[["$","p",null,{"className":"eyebrow","children":"AlexStudio"}],["$","h1",null,{"children":[["$","$L3",null,{"text":"PHOTOGRAPHY"}],["$","br",null,{}],["$","$L3",null,{"text":"& STUDIO SERVICES."}]]}],["$","p",null,{"children":["$","$L3",null,{"text":"Photography, restoration, printing and handmade work. With 30+ years of experience, Alex starts by listening to what you need."}]}]]}],["$","section",null,{"className":"service-directory shell","aria-label":"Services","children":[["$","$L10","events",{"slug":"events","name":"Event & portrait photography","intro":"Alex photographs all kinds of events and occasions: weddings, family celebrations, business events and portraits. His experience includes photography in a hot-air balloon and on a boat. Discuss your location and requirements with him."}],["$","$L10","restoration",{"slug":"restoration","name":"Old photo restoration","intro":"Old, damaged or torn photographs can need much more than a quick retouch. Alex discusses the condition of the original and the result you hope to achieve before recommending an approach."}],["$","$L10","framing",{"slug":"framing","name":"Custom handmade framing","intro":"Handmade frames for photographs and artwork, including unusual sizes and mounting requirements. Discuss the colour, material, dimensions and finish with Alex."}],["$","$L10","editing",{"slug":"editing","name":"Photoshop, retouching & enlargement","intro":"Photoshop, graphic editing, image preparation and enlargement. Tell Alex where the image will be used and what needs to change."}],["$","$L10","artwork",{"slug":"artwork","name":"Photo & artwork printing","intro":"Photographs and artwork prepared for paper, canvas, posters or glass. A surface changes the character of an image; Alex helps you choose it for the intended use."}],["$","$L10","personalized",{"slug":"personalized","name":"Photo gifts & sublimation printing","intro":"A meaningful photograph can become a shirt, a mug, a wooden photo block or another personalized object. Bring the idea and discuss the right material and process."}],["$","$L10","custom",{"slug":"custom","name":"Custom building & mounting","intro":"Alex also handles projects that need custom construction, mounting, gluing or painting. Describe the item, its dimensions and the result you need so he can assess the work."}]]}],["$","p",null,{"className":"service-future shell","children":["$","$L3",null,{"text":"Eye macro photography is a future service and is not currently available to book."}]}]]}]
