e-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right arrow" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></div></div><nav class="course__turn" aria-label="בחרו חוויה"><a href="#exp-1" aria-label="החוויה הקודמת"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></a><a href="#exp-3" aria-label="החוויה הבאה"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></a></nav><div class="setting course__table"><span class="piece piece--desk" style="--x:62%;--y:-3%;--w:40%;--r:24deg;--i:0" data-depth="1"><img src="/img/flowers.webp" alt="" decoding="async" loading="eager" draggable="false"/></span><span class="piece" style="--x:12%;--y:27%;--w:72%;--r:-7deg;--i:1;--mx:16%;--my:4%;--mw:88%;--mr:-7deg;z-index:2" data-depth="1"><img src="/img/platter.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece" style="--x:6%;--y:3%;--w:19%;--r:0deg;--i:2;--mx:-3%;--my:2%;--mw:26%;--mr:0deg;z-index:3" data-depth="1"><img src="/img/coupe-1.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:24%;--y:9%;--w:19%;--r:0deg;--i:3;z-index:3" data-depth="1"><img src="/img/coupe-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:41%;--y:2%;--w:19%;--r:0deg;--i:4;z-index:3" data-depth="1"><img src="/img/coupe-3.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:2%;--y:74%;--w:13%;--r:30deg;--i:5;z-index:3" data-depth="1"><img src="/img/fruit-3.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:85%;--y:40%;--w:14%;--r:-20deg;--i:6;z-index:3" data-depth="1"><img src="/img/fruit-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><figure class="print course__print"><picture><source media="(max-width: 520px)" srcSet="/img/photo-chef-dish-s.webp"/><img src="/img/photo-chef-dish.webp" alt="מנה מהמטבח של השף יוהאן" width="1080" height="720" loading="lazy" decoding="async" draggable="false"/></picture><figcaption>מנה מהמטבח של השף יוהאן</figcaption></figure></div></article><span class="course-anchor" id="exp-3"></span><article class="course cloth cloth--saffron" data-lay="true" aria-labelledby="course-title-3" style="--fs:7.56vw;--fsm:12.50vw"><div class="course__top"><span class="course__n" aria-hidden="true">0<!-- -->4<i>/ 04</i></span><span class="tag">השולחן שבו יוצרים</span></div><div class="course__copy"><h2 id="course-title-3"><span>מפשילים שרוולים.</span><em>נפגשים במטבח.</em></h2><p>מגלגלים סושי, מכינים פסטה טרייה או מגלים את התבלינים של הודו. מבשלים, לומדים וטועמים יחד — דרך טעימה לחבר חברים, משפחה או צוות.</p><span class="course__detail">סושי · פסטה ופיצה · מטבח הודי</span><div class="course__foot"><div class="card bill"><strong>החל מ־300 ₪ לאדם</strong><small>מינימום 4 משתתפים. בבית או במקום מתאים.</small></div><button class="btn btn--pop">נתכנן סדנה<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right arrow" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></button></div></div><nav class="course__turn" aria-label="בחרו חוויה"><a href="#exp-2" aria-label="החוויה הקודמת"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></a></nav><div class="setting course__table"><span class="piece" style="--x:16.5%;--y:2%;--w:44%;--r:-4deg;--i:0;--mx:36%;--my:6%;--mw:62%;--mr:-4deg;z-index:2" data-depth="1"><img src="/img/sushi.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:62%;--y:5%;--w:21%;--r:0deg;--i:1;z-index:3" data-depth="1"><img src="/img/pasta-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:80%;--y:17%;--w:21%;--r:40deg;--i:2;z-index:3" data-depth="1"><img src="/img/pasta-3.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece" style="--x:60%;--y:29%;--w:20%;--r:80deg;--i:3;--mx:2%;--my:4%;--mw:31%;--mr:80deg;z-index:3" data-depth="1"><img src="/img/pasta-4.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:90%;--y:46%;--w:8.5%;--r:24deg;--i:4;z-index:3" data-depth="1"><img src="/img/pasta-1.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:6%;--y:59%;--w:13%;--r:0deg;--i:5;z-index:3" data-depth="1"><img src="/img/spice-1.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:20%;--y:69%;--w:13%;--r:0deg;--i:6;z-index:3" data-depth="1"><img src="/img/spice-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:34%;--y:58%;--w:12.5%;--r:0deg;--i:7;z-index:3" data-depth="1"><img src="/img/spice-4.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:8%;--y:81%;--w:12.5%;--r:0deg;--i:8;z-index:3" data-depth="1"><img src="/img/spice-3.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><figure class="print course__print"><picture><source media="(max-width: 520px)" srcSet="/img/photo-workshop-s.webp"/><img src="/img/photo-workshop.webp" alt="בישול מעשי בסדנה של MyChef Israel" width="1080" height="720" loading="lazy" decoding="async" draggable="false"/></picture><figcaption>בישול מעשי בסדנה של MyChef Israel</figcaption></figure></div></article></div><section class="chef cloth cloth--linen" id="yohann" data-lay="true" aria-labelledby="chef-title"><span class="tag">02 / לכל שולחן יש נשמה</span><div class="chef__main"><h2 id="chef-title" data-rise="true" style="--fs:8.53vw;--fsm:11.37vw"><span>נשמה צרפתית.</span><span>לב ישראלי.</span><em>סקרנות בלי גבולות.</em></h2><div class="chef__prose" data-rise="true"><p>אני יוהאן. במטבח שלי הדיוק הצרפתי פוגש את החום של השולחן הישראלי, עם טעמים שאספתי לאורך הדרך בהודו, ביפן ובתאילנד.</p><p>כל מפגש מתחיל בשיחה. על הטעמים שלכם, האורחים שלכם ודרישות הכשרות. משם אני יוצר תפריט שהוא כולו שלכם.</p><span class="signature" lang="en" dir="ltr">Yohann</span><span class="signature__caption">השף שלכם, מהרעיון הראשון ועד המנה האחרונה</span></div><div class="setting chef__table" aria-hidden="true"><span class="piece piece--desk" style="--x:45%;--y:41%;--w:8%;--r:0deg;--i:1" data-depth="1"><img src="/img/spice-1.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:54%;--y:46%;--w:7.5%;--r:0deg;--i:2" data-depth="1"><img src="/img/spice-4.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:62%;--y:40%;--w:7.5%;--r:0deg;--i:3" data-depth="1"><img src="/img/spice-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span></div></div><div class="gallery"><figure class="print gallery__a"><picture><source media="(max-width: 520px)" srcSet="/img/photo-chef-dish-s.webp"/><img src="/img/photo-chef-dish.webp" alt="מנה מתוך תיק העבודות של השף יוהאן" width="1080" height="720" loading="lazy" decoding="async" draggable="false"/></picture><figcaption>01 — מהמטבח של יוהאן</figcaption></figure><div class="gallery__word" data-rise="true"><p><span>קצת<!-- --> <!-- -->דיוק.</span><em>המון לב.</em></p><a class="link-out" href="https://www.instagram.com/mychefisrael/" target="_blank" rel="noreferrer">עוד מהמטבח<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right arrow" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a></div><figure class="gallery__b"><span class="setting" aria-hidden="true"><span class="piece" style="--x:-28%;--y:52%;--w:70%;--r:-38deg;--i:2;--mx:-16%;--my:56%;--mw:60%;--mr:-38deg" data-depth="1"><img src="/img/olive.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span></span><img src="/img/plate-carpaccio.webp" alt="מנה נוספת שהכין השף יוהאן" width="760" height="760" loading="lazy" decoding="async" draggable="false"/><figcaption>02 — נוצר כדי לחלוק</figcaption></figure></div></section><section class="hosting cloth cloth--wine" id="details" data-lay="true" aria-labelledby="hosting-title"><div class="hosting__head"><span class="tag">03 / עכשיו, זה הערב שלכם</span><h2 id="hosting-title" data-rise="true" style="--fs:9.00vw;--fsm:15.00vw"><span>להיות אורחים.</span><em>בבית שלכם.</em></h2><p>מחומרי הגלם הראשונים ועד לסידור המטבח בסוף הערב — אני דואג לפרטים.</p></div><ol class="steps"><li class="card step" data-rise="true" style="--i:0"><span class="step__n" aria-hidden="true">01</span><h3>שיחה</h3><p>ספרו לי מה חוגגים, איפה ומי מגיע. נהפוך את זה לאישי.</p><span class="setting step__table" aria-hidden="true"><span class="piece" style="--x:62%;--y:-30%;--w:36%;--r:0deg;--i:1;--mx:66%;--my:-22%;--mw:30%;--mr:0deg" data-depth="1"><img src="/img/cup-1.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:34%;--y:-40%;--w:34%;--r:160deg;--i:2" data-depth="1"><img src="/img/cup-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span></span></li><li class="card step" data-rise="true" style="--i:1"><span class="step__n" aria-hidden="true">02</span><h3>תפריט, רק בשבילכם</h3><p>חומרי גלם עונתיים, הטעמים שלכם ורמת הכשרות שלכם, בהתאמה לצרכים התזונתיים שנגדיר יחד.</p><span class="setting step__table" aria-hidden="true"><span class="piece" style="--x:70%;--y:-34%;--w:11%;--r:14deg;--i:2;--mx:74%;--my:-28%;--mw:9%;--mr:14deg" data-depth="1"><img src="/img/fork.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece" style="--x:82%;--y:-30%;--w:11%;--r:22deg;--i:3;--mx:84%;--my:-24%;--mw:9%;--mr:22deg" data-depth="1"><img src="/img/knife.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span></span></li><li class="card step" data-rise="true" style="--i:2"><span class="step__n" aria-hidden="true">03</span><h3>ערב להתענג עליו</h3><p>אני קונה, מכין, מבשל ומגיש. אתם נהנים מהאנשים שלכם. בסוף אני משאיר מטבח מסודר.</p><span class="setting step__table" aria-hidden="true"><span class="piece" style="--x:68%;--y:-24%;--w:26%;--r:0deg;--i:3;--mx:72%;--my:-18%;--mw:22%;--mr:0deg" data-depth="1"><img src="/img/light-2.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:46%;--y:-36%;--w:22%;--r:0deg;--i:4" data-depth="1"><img src="/img/light-3.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span></span></li></ol></section><section class="questions cloth cloth--linen" aria-labelledby="questions-title"><div class="questions__head"><h2 id="questions-title" data-rise="true">כמה דברים, לפני שנפגשים</h2><span class="setting questions__table" aria-hidden="true"><span class="piece piece--desk" style="--x:6%;--y:0%;--w:42%;--r:-14deg;--i:0" data-depth="1"><img src="/img/fruit-1.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span><span class="piece piece--desk" style="--x:46%;--y:44%;--w:30%;--r:20deg;--i:1" data-depth="1"><img src="/img/fruit-3.webp" alt="" decoding="async" loading="lazy" draggable="false"/></span></span></div><div class="card questions__list"><details><summary>איפה אפשר לארח?<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus minus" aria-hidden="true"><path d="M5 12h14"></path></svg></summary><p>בבית או במקום פרטי מתאים. יוהאן פועל בעיקר בין אשדוד לנתניה; ניתן להגיע למקומות נוספים בארץ בהתאם לאירוע. שאלו על זמינות ועלויות נסיעה.</p></details><details><summary>אפשר להתאים לדרישות הכשרות שלנו?<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus minus" aria-hidden="true"><path d="M5 12h14"></path></svg></summary><p>כל תפריט מתוכנן לפי דרישות הכשרות שלכם. ציינו אותן בפנייה כדי שנוכל לסכם מראש את חומרי הגלם, אופן ההכנה וסידורי המטבח.</p></details><details><summary>ומה לגבי אלרגיות והעדפות תזונה?<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus minus" aria-hidden="true"><path d="M5 12h14"></path></svg></summary><p>ניתן לשלב בתפריט אפשרויות צמחוניות, מנות לילדים ובקשות תזונתיות מיוחדות. חשוב לשוחח עם יוהאן על כל אלרגיה לפני אישור ההזמנה.</p></details><details><summary>כמה עולה חוויה?<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus minus" aria-hidden="true"><path d="M5 12h14"></path></svg></summary><p>ארוחה פרטית החל מ־300 ₪ לאדם, בהתאם לתפריט ולמספר האורחים. סדנאות החל מ־300 ₪ לאדם, במינימום ארבעה משתתפים. המחיר הסופי יופיע בהצעה האישית שלכם.</p></details></div></section><section class="invitation cloth cloth--teal" id="contact" data-lay="true" aria-labelledby="invitation-title"><div class="invitation__copy"><span class="tag">יש משהו מיוחד בשולחן שלכם.</span><h2 id="invitation-title" style="--fs:12.00vw;--fsm:19.00vw"><span>בואו ניצור</span><em>זיכרון.</em></h2><p>ספרו לי מה חוגגים. אני אביא את הרעיונות.</p><div class="hero__actions"><button class="btn btn--pop">בואו נתכנן את הערב<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-